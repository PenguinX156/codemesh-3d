--- attempt 1 (0.0023 USD): straight-sided cylindrical coffee mug with thin walls, flat base and vertical C-shaped side handle: Fix under-size and mis-alignment: body radius from 3 non-handle bbox walls, straight side to rim, body translated to evidence.axis, handle direction snapped to max-extent cardinal axis with reach to bbox wall, thinner wall/tube and taller 0.88H-0.20H C-loop to fill green mask.
def build(api, evidence):
    ax = evidence.axis
    axx = ax[0]
    axz = ax[1]
    H = evidence.height
    base_y = evidence.base_y
    bbox = evidence.bbox
    bmin = bbox["min"]
    bmax = bbox["max"]
    bmin_x = bmin[0]
    bmin_z = bmin[2]
    bmax_x = bmax[0]
    bmax_z = bmax[2]
    op = evidence.opening()
    rim_y = op["rim_y"]
    inner_d = op["inner_depth_estimate"]
    d_px = bmax_x - axx
    d_nx = axx - bmin_x
    d_pz = bmax_z - axz
    d_nz = axz - bmin_z
    ux = -1.0
    uz = 0.0
    far = d_nx
    body_r = (d_px + d_pz + d_nz) / 3.0
    if d_px >= d_nx and d_px >= d_pz and d_px >= d_nz:
        ux = 1.0
        uz = 0.0
        far = d_px
        body_r = (d_nx + d_pz + d_nz) / 3.0
    else:
        if d_pz >= d_nx and d_pz >= d_px and d_pz >= d_nz:
            ux = 0.0
            uz = 1.0
            far = d_pz
            body_r = (d_px + d_nx + d_nz) / 3.0
        else:
            if d_nz >= d_nx and d_nz >= d_px and d_nz >= d_pz:
                ux = 0.0
                uz = -1.0
                far = d_nz
                body_r = (d_px + d_nx + d_pz) / 3.0
            else:
                ux = -1.0
                uz = 0.0
                far = d_nx
                body_r = (d_px + d_pz + d_nz) / 3.0
    tube_r = body_r * 0.055
    if tube_r < 0.006:
        tube_r = 0.006
    if tube_r > 0.009:
        tube_r = 0.009
    wall_t = body_r * 0.045
    if wall_t < 0.005:
        wall_t = 0.005
    if wall_t > 0.008:
        wall_t = 0.008
    floor_t = rim_y - inner_d - base_y
    if floor_t < 0.008:
        floor_t = 0.008
    if floor_t > 0.02:
        floor_t = 0.015
    outer_d = far - tube_r - 0.001
    min_out = body_r + 0.025
    if outer_d < min_out:
        outer_d = min_out
    r_low = body_r * 0.9
    y0 = base_y
    y1 = base_y + H * 0.08
    y2 = base_y + H
    outer = [(0.0, y0), (r_low, y0), (body_r, y1), (body_r, y2)]
    body0 = api.revolve(profile=outer, segments=48, wall=wall_t, floor=floor_t)
    body = api.translate(body0, axx, 0.0, axz)
    d_in = body_r * 0.8
    d_mid = body_r + (outer_d - body_r) * 0.55
    d_out = outer_d
    yta = base_y + H * 0.88
    ytb = base_y + H * 0.86
    yto = base_y + H * 0.75
    ymo = base_y + H * 0.54
    ybo = base_y + H * 0.32
    ybb = base_y + H * 0.22
    yba = base_y + H * 0.2
    x0 = axx + ux * d_in
    z0 = axz + uz * d_in
    x1 = axx + ux * d_mid
    z1 = axz + uz * d_mid
    x2 = axx + ux * d_out
    z2 = axz + uz * d_out
    x3 = axx + ux * d_out
    z3 = axz + uz * d_out
    x4 = axx + ux * d_out
    z4 = axz + uz * d_out
    x5 = axx + ux * d_mid
    z5 = axz + uz * d_mid
    x6 = axx + ux * d_in
    z6 = axz + uz * d_in
    hpath = [(x0, yta, z0), (x1, ytb, z1), (x2, yto, z2), (x3, ymo, z3), (x4, ybo, z4), (x5, ybb, z5), (x6, yba, z6)]
    handle = api.sweep(path=hpath, radius=tube_r)
    return api.combine([body, handle])

