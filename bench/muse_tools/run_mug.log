--- attempt 0 (0.0034 USD): straight-sided cylindrical coffee mug with thin walls, flat base and vertical C-shaped side handle: Use evidence height/base/axis/rim/opening for scale. Body radius from radius_profile upper average to avoid handle bulge, bottom radius from profile base, rim radius from opening. Hollow vessel via revolve with wall ~7% radius and floor from inner_depth. Handle direction from bbox centre offset from axis (negative-X), reach from ray-bbox intersection minus tube radius, C-shaped 7-point sweep in radial-vertical plane from 0.80H to 0.30H. Combine body+handle centred on axis.
def build(api, evidence):
    ax = evidence.axis
    axx = ax[0]
    axz = ax[1]
    H = evidence.height
    base_y = evidence.base_y
    bbox = evidence.bbox
    bmin = bbox["min"]
    bmax = bbox["max"]
    bmin_x = bmin[0]
    bmin_z = bmin[2]
    bmax_x = bmax[0]
    bmax_z = bmax[2]
    op = evidence.opening()
    rim_y = op["rim_y"]
    rim_r = op["rim_radius"]
    inner_d = op["inner_depth_estimate"]
    rp = evidence.radius_profile(12)
    rsum = 0.0
    rcnt = 0
    for i in range(len(rp)):
        y = rp[i][0]
        r = rp[i][1]
        if y > H * 0.32:
            if y < H * 0.96:
                rsum = rsum + r
                rcnt = rcnt + 1
    r_body = rsum / rcnt
    r_bot = rp[0][1]
    r_top = rim_r
    floor_t = (rim_y - inner_d) - base_y
    if floor_t < 0.008:
        floor_t = 0.008
    if floor_t > H * 0.2:
        floor_t = H * 0.12
    wall_t = r_body * 0.07
    if wall_t < 0.006:
        wall_t = 0.006
    if wall_t > 0.014:
        wall_t = 0.012
    tube_r = r_body * 0.085
    if tube_r < 0.008:
        tube_r = 0.008
    if tube_r > 0.014:
        tube_r = 0.014
    cxx = (bmin_x + bmax_x) * 0.5
    czz = (bmin_z + bmax_z) * 0.5
    dx = cxx - axx
    dz = czz - axz
    dl = (dx * dx + dz * dz) ** 0.5
    ux = -1.0
    uz = 0.0
    if dl > 0.000001:
        ux = dx / dl
        uz = dz / dl
    tx = 10.0
    tz = 10.0
    if abs(ux) > 0.0001:
        if ux > 0.0:
            tx = (bmax_x - axx) / ux
        else:
            tx = (bmin_x - axx) / ux
    if abs(uz) > 0.0001:
        if uz > 0.0:
            tz = (bmax_z - axz) / uz
        else:
            tz = (bmin_z - axz) / uz
    far = tx
    if tz < far:
        far = tz
    outer_d = far - tube_r - 0.002
    min_outer = r_body + 0.02
    if outer_d < min_outer:
        outer_d = min_outer
    outer = [(0.0, base_y), (r_bot, base_y), (r_body, base_y + H * 0.12), (r_body, base_y + H * 0.70), (r_top, base_y + H)]
    body = api.revolve(profile=outer, segments=32, wall=wall_t, floor=floor_t)
    d0 = r_body * 0.92
    d1 = r_body + (outer_d - r_body) * 0.65
    d2 = outer_d
    y0 = base_y + H * 0.80
    y1 = base_y + H * 0.80
    y2 = base_y + H * 0.68
    y3 = base_y + H * 0.55
    y4 = base_y + H * 0.42
    y5 = base_y + H * 0.30
    y6 = base_y + H * 0.30
    x0 = axx + ux * d0
    z0 = axz + uz * d0
    x1 = axx + ux * d1
    z1 = axz + uz * d1
    x2 = axx + ux * d2
    z2 = axz + uz * d2
    x3 = axx + ux * d2
    z3 = axz + uz * d2
    x4 = axx + ux * d2
    z4 = axz + uz * d2
    x5 = axx + ux * d1
    z5 = axz + uz * d1
    x6 = axx + ux * d0
    z6 = axz + uz * d0
    hpath = [(x0, y0, z0), (x1, y1, z1), (x2, y2, z2), (x3, y3, z3), (x4, y4, z4), (x5, y5, z5), (x6, y6, z6)]
    handle = api.sweep(path=hpath, radius=tube_r)
    return api.combine([body, handle])

